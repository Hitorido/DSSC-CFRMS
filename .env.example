# CFRMS Environment Variables Template
# Copy this file to '.env' and fill in your local credentials.

DJANGO_DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database Configuration (local development)
DB_NAME=dssc_cfrms_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Analytics Database (Aiven Cloud MySQL) — OPTIONAL
# ---------------------------------------------------------------------------
# Leave ANALYTICS_DB_HOST empty (or do not set it) to disable the analytics
# alias entirely. When unset, local Django operation is completely unaffected.
#
# Never commit real credentials. Copy these keys to a separate '.env.analytics'
# file (also gitignored) and load it only when running analytics operations.
#
# ANALYTICS_DB_NAME     — cloud database name (must be different from DB_NAME)
# ANALYTICS_DB_USER     — dedicated analytics database user
# ANALYTICS_DB_PASSWORD — analytics user password
# ANALYTICS_DB_HOST     — Aiven hostname, e.g. mysql-xxxx.aivencloud.com
# ANALYTICS_DB_PORT     — Aiven port (Aiven default is typically 3306 or custom)
# ANALYTICS_DB_SSL_CA   — absolute path to the Aiven CA certificate (.pem file)
#                         Download from: Aiven Console > Service > Connection Info
#
# ANALYTICS_DB_NAME=dssc_analytics
# ANALYTICS_DB_USER=django_analytics
# ANALYTICS_DB_PASSWORD=your_analytics_password
# ANALYTICS_DB_HOST=mysql-xxxx.aivencloud.com
# ANALYTICS_DB_PORT=3306
# ANALYTICS_DB_SSL_CA=/absolute/path/to/aiven-ca.pem
